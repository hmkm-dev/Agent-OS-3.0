# Copy this to .env and fill in real values. NEVER commit .env.
# Every variable the system uses lives here — grouped per component.

# ============================================================
# APPLICATION
# ============================================================
APP_ENV=development
MAX_AGENT_RETRIES=3
TASK_TIMEOUT=120
APPROVAL_TIMEOUT=3600
# HEALTHCHECK_MODE controls scripts/healthcheck.sh's required-vs-optional
# service classification. "dev" (default) only requires Redis+Hermes.
# "production" requires the full core stack (postgres, all 3 workers,
# mcp, playwright) and additionally requires caddy+cloudflared when
# CF_TUNNEL_TOKEN is set. See docs/OPERATIONS.md.
HEALTHCHECK_MODE=dev
# HYBRID_MODE=1 starts OpenCode + MCP + Playwright while specialist worker
# containers remain dormant and available as compatibility fallbacks.
HYBRID_MODE=0

# ============================================================
# DATABASE (PostgreSQL)
# ============================================================
DATABASE_PASSWORD=change-me-strong-random-password
DATABASE_URL=

# ============================================================
# REDIS
# ============================================================
REDIS_PASSWORD=change-me-strong-random-password

# ============================================================
# OPENROUTER (model routing)
# ============================================================
OPENROUTER_API_KEY=
MODEL_REASONING=anthropic/claude-sonnet-4.5
MODEL_CODING=anthropic/claude-sonnet-4.5
MODEL_CREATIVE=anthropic/claude-sonnet-4.5
MODEL_FAST=google/gemini-2.0-flash-001
MODEL_FALLBACK=google/gemini-2.0-flash-001

# ============================================================
# OPENCODE (coding worker runtime)
# ============================================================
OPENCODE_BIN=opencode
OPENCODE_MODEL=
OPENCODE_TIMEOUT_SECONDS=100
OPENCODE_MAX_TIMEOUT_SECONDS=900
AGENT_RUNTIME=opencode

# ============================================================
# INTERNAL SERVICE URLS (optional overrides — sane defaults match
# the internal Docker network names in docker-compose.yml; only
# change these if you're running services outside Compose)
# ============================================================
MCP_URL=http://mcp:8100
MODEL_ROUTER_URL=http://hermes:8000/internal/route
PLAYWRIGHT_URL=http://playwright:8200
WORKSPACE_ROOT=/workspaces
MAX_RETRIES=3
# REDIS_URL is normally auto-assembled by docker-compose.yml from
# REDIS_PASSWORD (redis://:$REDIS_PASSWORD@redis:6379/0) — only set this
# directly if running a service outside Compose.
REDIS_URL=

# ============================================================
# CLOUDFLARE
# ============================================================
CF_TUNNEL_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ============================================================
# GITHUB (MCP tool)
# ============================================================
GITHUB_TOKEN=

# ============================================================
# SEARCH (MCP tool)
# ============================================================
SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=

# ============================================================
# PLAYWRIGHT
# ============================================================
PLAYWRIGHT_TIMEOUT_MS=30000

# ============================================================
# QDRANT (semantic memory — Qdrant Cloud, not self-hosted)
# ============================================================
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=agent_memory
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
# OPENAI_API_KEY is accepted as a fallback if EMBEDDING_API_KEY is unset
# (see services/memory/embeddings.py) — set one or the other, not required to set both.
OPENAI_API_KEY=

# ============================================================
# R2 (Cloudflare object storage)
# ============================================================
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_ARTIFACTS=agentos-artifacts
R2_BUCKET_BACKUPS=agentos-backups

# ============================================================
# N8N
# ============================================================
N8N_ENCRYPTION_KEY=
N8N_HOST=n8n.yourdomain.com
HERMES_URL=http://hermes:8000

# ============================================================
# MISSION CONTROL (goal-completion harness)
# ============================================================
MISSIONS_ROOT=/workspaces/missions
CONTEXT_SUMMARIZE_THRESHOLD_CHARS=8000

# ============================================================
# SECURITY
# ============================================================
HERMES_API_KEY=change-me-strong-random-key

# ============================================================
# MONITORING / ALERTING
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
